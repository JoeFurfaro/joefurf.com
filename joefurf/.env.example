# Copy to .env for local development. Bun loads it automatically.
PUBLIC_URL=http://localhost:5173

# Generate both with: bun run hash-password
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Stripe test-mode keys (dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TAX_ENABLED=false

# Optional locally: emails are printed to the console when unset
RESEND_API_KEY=
EMAIL_FROM=Joe Furfaro <shop@joefurf.com>
ADMIN_EMAIL=joefurf@outlook.com
